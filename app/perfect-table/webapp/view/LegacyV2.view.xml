<mvc:View controllerName="poc.app.controller.LegacyV2" height="100%" xmlns="sap.m" xmlns:f="sap.f" xmlns:mvc="sap.ui.core.mvc" xmlns:sj="starj.ui5.table">
	<f:DynamicPage id="page" headerExpanded="true" fitContent="false">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading><Title text="반쪽 OData V2 (RFC 래핑)"/></f:heading>
				<f:expandedContent><Text id="info"/></f:expandedContent>
				<f:navigationActions><Button icon="sap-icon://home" tooltip="홈" press=".onNavHome"/></f:navigationActions>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader pinnable="true">
				<sj:FilterBar id="filter"/>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<sj:Table id="table" filter="filter" kind="v2" url="/odata/v2/legacy" entitySet="ProductList" header="ProductList (반쪽 V2)" loaded=".onLoaded" save=".onSave"/>
		</f:content>
	</f:DynamicPage>
</mvc:View>
